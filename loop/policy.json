{
  "$schema": "./schema/policy.schema.json",
  "version": 1,
  "terminalStates": [
    "success",
    "no-op",
    "blocked",
    "stalled",
    "exhausted"
  ],
  "budgets": {
    "maxIterationsPerTask": 5,
    "maxIterationMinutes": 120,
    "stallAfterSameSignature": 2
  },
  "evidence": {
    "levels": [
      {
        "id": "L1",
        "meaning": "결정적: 종료 코드, assert, 정답 출력(build/vet/test/fixture diff/checksum)"
      },
      {
        "id": "L2",
        "meaning": "규칙: 린터, 스키마, 정책(gofmt, tsc, JSON Schema, ASCII 검사, loopctl check)"
      },
      {
        "id": "L3",
        "meaning": "늦게 오는 현실: 온라인 E2E, 반복 재현된 성능 측정, 실제 실행 로그"
      },
      {
        "id": "L4",
        "meaning": "모델 판정: 별도 컨텍스트의 검증 에이전트가 루브릭으로 판단"
      },
      {
        "id": "L5",
        "meaning": "사람: Premiere 화면 확인, 실기 테스트, 승인"
      }
    ],
    "successRequires": [
      {
        "kind": "test",
        "maxLevel": "L1"
      }
    ],
    "perfRegressionNeedsReproductions": 3,
    "webClaimNeedsSources": 2,
    "secondaryMustCitePrimary": true
  },
  "humanGates": [
    {
      "action": "git.merge.main",
      "why": "main은 검증된 상태만. 병합은 사람이 한다."
    },
    {
      "action": "git.push",
      "why": "외부로 나가는 작업은 되돌리기 어렵다."
    },
    {
      "action": "system.settings",
      "why": "저장소 밖 변경(PlayerDebugMode, CEP 확장 링크, Rosetta 등). 빌드가 링크를 남긴 사례(2026-10-02)."
    },
    {
      "action": "adr.replace",
      "why": "설계 결정 교체는 근거·범위·이전 비용을 사람이 판단한다."
    },
    {
      "action": "verifier.change",
      "why": "검증기는 피검증자가 고칠 수 없다(보상 해킹 방지). protected 경로의 수정·삭제."
    },
    {
      "action": "tools.install.global",
      "why": "사용자 데이터 폴더·시스템 경로에 도구 설치."
    }
  ],
  "protected": {
    "gate": "verifier.change",
    "why": "구현 세션은 아래 경로에 새 파일 추가만 가능. 기존 파일의 수정·삭제는 iteration.approvals에 verifier.change 승인이 있어야 한다.",
    "paths": [
      "loop/policy.json",
      "loop/schema/**",
      "specs/**",
      "docs/decisions/premises.json",
      "protocol/fixtures/**",
      "helper/**/*_test.go",
      "panel/core/test/**",
      "scripts/test-helper.sh",
      "tools/**/*_test.go",
      "panel/cep/test/golden/**",
      "panel/core/test/golden/**"
    ]
  },
  "storage": {
    "commit": [
      "loop/policy.json",
      "loop/schema/**",
      "loop/backlog.json",
      "loop/ledger/**",
      "loop/iterations/**"
    ],
    "local": [
      "loop/.runs/**",
      "helper/.perf/**"
    ],
    "maxCommittedFileBytes": 65536,
    "redactPatterns": [
      "token=[0-9a-f]{16,}",
      "\"token\"\\s*:\\s*\"[0-9a-f]{16,}\"",
      "(?i)set-cookie:",
      "(?i)authorization:\\s*\\S+",
      "gh[pousr]_[A-Za-z0-9]{20,}"
    ],
    "localRetentionDays": 30
  },
  "sessions": {
    "unit": "iteration",
    "oneTaskPerSession": true,
    "kinds": [
      "bootstrap",
      "design",
      "worker",
      "verifier",
      "research",
      "watch"
    ],
    "freshContextFor": [
      "worker",
      "verifier",
      "watch"
    ],
    "startupRoutine": [
      "git status --short && git log --oneline -5",
      "make orient",
      "make verify"
    ],
    "handoffRequired": true,
    "knowledgeHome": "저장소(SSOT: loop/, specs/, docs/decisions/premises.json)가 진실. 에이전트 메모리는 포인터와 사용자 선호만 담는다."
  },
  "readiness": {
    "appliesTo": [
      "worker",
      "watch"
    ],
    "requireGates": [
      "G-vet",
      "G-gen",
      "G-loop",
      "G-tools",
      "G-helper",
      "G-core"
    ],
    "compileAcceptanceMaxLevel": "L2",
    "specChurn": {
      "paths": [
        "specs/**",
        "loop/policy.json",
        "loop/schema/**"
      ],
      "windowDays": 14,
      "maxCommits": 10
    },
    "why": "루프의 수렴력은 검증기에서 나온다. 게이트·기계 판정 완료 조건·안정된 명세가 없으면 0→1 단계로 보고 사람 주도로 진행한다(원칙 L1)."
  },
  "gateLadder": [
    {
      "id": "G-fmt",
      "level": "L2",
      "kind": "build",
      "cost": "free",
      "estSec": 2,
      "what": "gofmt 위반 없음",
      "argv": [
        "sh",
        "-c",
        "test -z \"$(gofmt -l helper tools)\""
      ]
    },
    {
      "id": "G-vet",
      "level": "L1",
      "kind": "build",
      "cost": "free",
      "estSec": 20,
      "what": "go vet (mac + windows 크로스 + tools)",
      "argv": [
        "sh",
        "-c",
        "cd helper && go vet ./... && GOOS=windows go vet ./... && cd ../tools && go vet ./..."
      ]
    },
    {
      "id": "G-gen",
      "level": "L1",
      "kind": "spec",
      "cost": "free",
      "estSec": 3,
      "what": "생성물이 specs/와 일치",
      "dir": "tools",
      "argv": [
        "go",
        "run",
        "./cmd/specgen",
        "-check"
      ]
    },
    {
      "id": "G-loop",
      "level": "L2",
      "kind": "spec",
      "cost": "free",
      "estSec": 3,
      "what": "루프 상태·정책·원칙 규칙",
      "dir": "tools",
      "argv": [
        "go",
        "run",
        "./cmd/loopctl",
        "check"
      ]
    },
    {
      "id": "G-tools",
      "level": "L1",
      "kind": "test",
      "cost": "free",
      "estSec": 5,
      "what": "루프 도구 테스트",
      "dir": "tools",
      "argv": [
        "go",
        "test",
        "-count=1",
        "./..."
      ]
    },
    {
      "id": "G-cep",
      "level": "L2",
      "kind": "build",
      "cost": "free",
      "estSec": 5,
      "what": "CEP 패널 타입 검사",
      "dir": "panel/cep",
      "argv": [
        "npx",
        "tsc",
        "-p",
        "tsconfig-build.json"
      ],
      "requires": [
        "panel/cep/node_modules"
      ]
    },
    {
      "id": "G-core",
      "level": "L1",
      "kind": "test",
      "cost": "free",
      "estSec": 5,
      "what": "패널 코어 테스트(프로토콜 계약 포함)",
      "dir": "panel/core",
      "argv": [
        "npx",
        "vitest",
        "run"
      ],
      "requires": [
        "panel/core/node_modules"
      ]
    },
    {
      "id": "G-helper",
      "level": "L1",
      "kind": "test",
      "cost": "slow",
      "estSec": 20,
      "what": "Helper 전체 테스트 + 성능 기록(로컬 E2E 포함)",
      "argv": [
        "scripts/test-helper.sh"
      ]
    },
    {
      "id": "G-premises",
      "level": "L3",
      "kind": "premise",
      "cost": "slow",
      "estSec": 40,
      "what": "ADR 전제 검사",
      "dir": "tools",
      "argv": [
        "go",
        "run",
        "./cmd/loopctl",
        "premises"
      ]
    },
    {
      "id": "G-e2e",
      "level": "L3",
      "kind": "test",
      "cost": "network",
      "estSec": 10,
      "optional": true,
      "what": "실제 플랫폼 온라인 E2E(엔진 변경 시)",
      "argv": [
        "scripts/test-helper.sh",
        "--e2e",
        "--",
        "-run",
        "TestEndToEndOnline"
      ]
    },
    {
      "id": "G-review",
      "level": "L4",
      "kind": "review",
      "cost": "tokens",
      "optional": true,
      "what": "별도 컨텍스트 검증 에이전트의 반박 시도"
    },
    {
      "id": "G-human",
      "level": "L5",
      "kind": "human",
      "cost": "human",
      "optional": true,
      "what": "사람 확인(Premiere 화면, 실기, 병합 승인)"
    }
  ],
  "divergence": {
    "allowedWhen": [
      "verifier-selects",
      "independent-parallel-research"
    ],
    "maxCandidates": 4,
    "maxSubagentsPerPulse": 3,
    "maxTokensPerPulse": 500000,
    "outputTo": [
      "ledger",
      "backlog"
    ],
    "why": "멀티에이전트는 채팅 대비 약 15배 토큰. 이 세션의 16개 저장소 분석(서브에이전트 3개)이 약 46만 토큰이었다(원칙 L2·A5)."
  },
  "models": {
    "routing": [
      {
        "role": "mechanical",
        "model": "none",
        "why": "gofmt·specgen·loopctl 같은 결정적 도구로 처리(0토큰)"
      },
      {
        "role": "bulk",
        "model": "haiku",
        "why": "대량 요약·분류(Opus 대비 약 1/10 단가)"
      },
      {
        "role": "research",
        "model": "sonnet",
        "why": "독립 병렬 조사"
      },
      {
        "role": "implement",
        "model": "opus",
        "why": "구현"
      },
      {
        "role": "diagnose",
        "model": "opus",
        "why": "원인 분석·설계"
      },
      {
        "role": "verify",
        "model": "opus",
        "context": "fresh",
        "why": "반박 시도는 새 컨텍스트에서(maker/checker 분리)"
      }
    ]
  },
  "feedback": {
    "tailLines": 20,
    "include": [
      "claim",
      "signature",
      "tail",
      "artifact"
    ]
  },
  "cost": {
    "track": [
      "tokens",
      "usd",
      "minutes"
    ],
    "reviewEveryIterations": 10,
    "kpi": "costPerAcceptedChange"
  }
}
