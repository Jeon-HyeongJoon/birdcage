{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loop/backlog.schema.json",
  "title": "Backlog: tasks with acceptance criteria. Only gates (evidence) may flip `passes`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks"],
  "properties": {
    "$schema": { "type": "string" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "mode", "status", "passes", "acceptance"],
        "properties": {
          "id": { "type": "string", "pattern": "^T-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["compile", "discovery", "human"] },
          "status": { "enum": ["open", "doing", "done", "blocked"] },
          "passes": { "type": "boolean" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "dependsOn": { "type": "array", "items": { "type": "string", "pattern": "^T-[0-9]{3}$" } },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "maxLevel", "what"],
              "properties": {
                "kind": { "enum": ["test", "build", "perf", "log", "web", "code", "premise", "review", "human", "spec"] },
                "maxLevel": { "enum": ["L1", "L2", "L3", "L4", "L5"] },
                "what": { "type": "string" }
              }
            }
          },
          "evidence": { "type": "array", "items": { "type": "string", "pattern": "^E-" } },
          "blockedBy": { "type": "string" }
        }
      }
    }
  }
}
