{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specs/principles.schema.json",
  "title": "Project principles (work / loop / agent): each rule names how it is enforced",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "groups", "principles"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": { "id": { "type": "string" }, "title": { "type": "string" } }
      }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "rule", "why", "enforcedBy", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[WLA][0-9]{1,2}$" },
          "group": { "type": "string" },
          "rule": { "type": "string", "minLength": 1, "description": "규범 문장(의미에 포함)" },
          "why": { "type": "string", "description": "근거 요약(의미 해시에서 제외)" },
          "evidence": { "type": "array", "items": { "type": "string" }, "description": "URL 또는 session:<사실> (의미 해시에서 제외)" },
          "enforcedBy": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": { "enum": ["loopctl-rule", "premise", "policy", "generated", "gate", "honor"] },
                "ref": { "type": "string" }
              }
            }
          },
          "status": { "enum": ["enforced", "partial", "honor"] }
        }
      }
    }
  }
}
