{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/decisions/premises.schema.json",
  "title": "Executable premises of design decisions (ADRs). A failing premise flags its ADR for review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["premises"],
  "properties": {
    "$schema": { "type": "string" },
    "premises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "adr", "claim", "level", "check"],
        "properties": {
          "id": { "type": "string", "pattern": "^P-[0-9]{4}-[a-z]$" },
          "adr": { "type": "string", "pattern": "^[0-9]{4}$" },
          "claim": { "type": "string", "minLength": 1 },
          "level": { "enum": ["L1", "L2", "L3", "L4", "L5"] },
          "sources": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "check": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false, "required": ["type", "path", "pattern"],
                "properties": { "type": { "const": "file-regex" }, "path": { "type": "string" }, "pattern": { "type": "string" } }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["type", "paths"],
                "properties": { "type": { "const": "file-ascii" }, "paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 } }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["type", "glob", "pattern"],
                "description": "Every directory containing files matching glob must have at least one such file matching pattern.",
                "properties": { "type": { "const": "per-dir-regex" }, "glob": { "type": "string" }, "pattern": { "type": "string" } }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["type", "argv"],
                "properties": {
                  "type": { "const": "command" },
                  "argv": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                  "dir": { "type": "string" },
                  "timeoutSec": { "type": "integer", "minimum": 1 },
                  "maxMs": { "type": "integer", "minimum": 1 },
                  "requiresEnv": { "type": "array", "items": { "type": "string" } }
                }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["type", "verifiedAt", "ttlDays"],
                "description": "External fact verified on a date; fails (needs re-research) after ttlDays.",
                "properties": { "type": { "const": "expires" }, "verifiedAt": { "type": "string", "format": "date" }, "ttlDays": { "type": "integer", "minimum": 1 } }
              }
            ]
          }
        }
      }
    }
  }
}
